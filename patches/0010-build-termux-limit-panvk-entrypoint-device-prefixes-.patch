From d1ee55a39b44bed4c89ac2e3e03a4203ecbe8c43 Mon Sep 17 00:00:00 2001
From: OpenCode Build <build@localhost>
Date: Mon, 19 Oct 2026 20:43:57 +0300
Subject: [PATCH panvk-kirin990 10/23] build(termux): limit panvk entrypoint
 device-prefixes to built archs

---
 src/panfrost/vulkan/meson.build | 30 ++++++++++++++++++++----------
 1 file changed, 20 insertions(+), 10 deletions(-)

diff --git a/src/panfrost/vulkan/meson.build b/src/panfrost/vulkan/meson.build
index 6ccb4d43fee..e106bbc1e0f 100644
--- a/src/panfrost/vulkan/meson.build
+++ b/src/panfrost/vulkan/meson.build
@@ -4,6 +4,23 @@
 # Copyright © 2017 Intel Corporation
 # SPDX-License-Identifier: MIT
 
+# Termux/kbase portability fix: the kbase backend only implements the Job
+# Manager (Bifrost/JM) path.  The CSF (Valhall) panvk sources reference
+# panthor-only helpers (panthor_kmod_get_csif_props / panthor_kmod_get_flush_id)
+# that are not compiled when the panthor kmd is not selected, so only build the
+# JM architectures in that configuration.  v9 has no per-arch library either
+# way and is referenced weakly.
+if panfrost_kmds.contains('kbase') and not panfrost_kmds.contains('panthor')
+  panvk_archs = [6, 7]
+else
+  panvk_archs = [6, 7, 10, 12, 13, 14]
+endif
+
+panvk_device_prefix_args = []
+foreach arch : panvk_archs
+  panvk_device_prefix_args += ['--device-prefix', 'panvk_v@0@'.format(arch)]
+endforeach
+
 panvk_entrypoints = custom_target(
   'panvk_entrypoints.[ch]',
   input : [vk_entrypoints_gen, vk_api_xml],
@@ -11,10 +28,7 @@ panvk_entrypoints = custom_target(
   command : [
     prog_python, '@INPUT0@', '--xml', '@INPUT1@', '--proto', '--weak',
     '--out-h', '@OUTPUT0@', '--out-c', '@OUTPUT1@', '--prefix', 'panvk',
-    '--device-prefix', 'panvk_v6', '--device-prefix', 'panvk_v7',
-    '--device-prefix', 'panvk_v9', '--device-prefix', 'panvk_v10',
-    '--device-prefix', 'panvk_v12', '--device-prefix', 'panvk_v13',
-    '--device-prefix', 'panvk_v14',
+    panvk_device_prefix_args,
     '--beta', with_vulkan_beta.to_string()
   ],
   depend_files : vk_entrypoints_gen_depend_files,
@@ -142,12 +156,8 @@ common_per_arch_files = [
   sha1_h,
 ]
 
-# Termux/kbase portability fix: the kbase backend only implements the Job
-# Manager (Bifrost/JM) path.  The CSF (Valhall) panvk sources reference
-# panthor-only helpers (panthor_kmod_get_csif_props / panthor_kmod_get_flush_id)
-# that are not compiled when the panthor kmd is not selected, so only build the
-# JM architectures in that configuration.
-foreach arch : ((panfrost_kmds.contains('kbase') and not panfrost_kmds.contains('panthor')) ? [6, 7] : [6, 7, 10, 12, 13, 14])
+# Build one panvk library per supported architecture (see panvk_archs above).
+foreach arch : panvk_archs
   per_arch_files = common_per_arch_files
   inc_panvk_per_arch = []
 
