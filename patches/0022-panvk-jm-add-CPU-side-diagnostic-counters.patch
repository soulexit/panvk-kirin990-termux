diff --git a/src/panfrost/vulkan/panvk_jm_diag.h b/src/panfrost/vulkan/panvk_jm_diag.h
new file mode 100644
index 00000000000..9a043b705ab
--- /dev/null
+++ b/src/panfrost/vulkan/panvk_jm_diag.h
@@ -0,0 +1,46 @@
+#ifndef PANVK_JM_DIAG_H
+#define PANVK_JM_DIAG_H
+
+#include <stdatomic.h>
+#include <stdint.h>
+
+#include "util/os_time.h"
+
+struct panvk_jm_diag {
+   _Atomic uint64_t draw_ns;
+   _Atomic uint64_t draw_count;
+   _Atomic uint64_t barrier_ns;
+   _Atomic uint64_t barrier_count;
+   _Atomic uint64_t render_ns;
+   _Atomic uint64_t render_count;
+   _Atomic uint64_t desc_ns;
+   _Atomic uint64_t desc_count;
+   _Atomic uint64_t update_ns;
+   _Atomic uint64_t update_count;
+   _Atomic uint64_t vbs_ns;
+   _Atomic uint64_t vbs_count;
+   _Atomic uint64_t ib_ns;
+   _Atomic uint64_t ib_count;
+   _Atomic uint64_t push_ns;
+   _Atomic uint64_t push_count;
+   _Atomic uint64_t present_ns;
+   _Atomic uint64_t present_count;
+};
+
+extern struct panvk_jm_diag panvk_jm_diag;
+
+static inline uint64_t
+panvk_jm_diag_begin(void)
+{
+   return os_time_get_nano();
+}
+
+static inline void
+panvk_jm_diag_end(_Atomic uint64_t *ns, _Atomic uint64_t *count, uint64_t t0)
+{
+   uint64_t dt = os_time_get_nano() - t0;
+   atomic_fetch_add_explicit(ns, dt, memory_order_relaxed);
+   atomic_fetch_add_explicit(count, 1, memory_order_relaxed);
+}
+
+#endif /* PANVK_JM_DIAG_H */
