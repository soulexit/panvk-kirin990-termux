diff --git a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
index ba688ca2010..90aad17efe9 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
@@ -22,6 +22,7 @@
 #include "panvk_instance.h"
 #include "panvk_physical_device.h"
 #include "panvk_priv_bo.h"
+#include "panvk_jm_diag.h"
 #include "panvk_queue.h"
 
 #include "kmod/kbase_kmod.h"
@@ -37,6 +38,7 @@
 #include "drm-uapi/mali_kbase_ioctl.h"
 #include <fcntl.h>
 #include <inttypes.h>
+#include <unistd.h>
 #include <poll.h>
 #include <pthread.h>
 #include <stdarg.h>
@@ -49,6 +51,7 @@
  * storage, because the app's emulog does not capture driver stderr. */
 static uint64_t jm_diag_submit_ns, jm_diag_wait_ns;
 static uint64_t jm_diag_submit_max_ns, jm_diag_wait_max_ns;
+static uint64_t jm_diag_window_start_ns;
 static unsigned jm_diag_submits, jm_diag_waits, jm_diag_atoms;
 static unsigned jm_diag_atoms_max;
 
@@ -100,6 +103,35 @@ panvk_jm_log(const char *fmt, ...)
    pthread_mutex_unlock(&jm_log_lock);
 }
 
+static unsigned
+jm_read_gpu_khz(void)
+{
+   static const char *paths[] = {
+      "/sys/class/misc/mali0/device/devfreq/ffb40000.mali/cur_freq",
+      "/sys/class/misc/mali0/device/cur_freq",
+      "/sys/class/misc/mali0/device/scaling_cur_freq",
+      "/sys/class/devfreq/ffb40000.mali/cur_freq",
+   };
+
+   for (unsigned i = 0; i < ARRAY_SIZE(paths); i++) {
+      char buf[64];
+      int fd = open(paths[i], O_RDONLY | O_CLOEXEC);
+      if (fd < 0)
+         continue;
+      ssize_t n = read(fd, buf, sizeof(buf) - 1);
+      close(fd);
+      if (n <= 0)
+         continue;
+      buf[n] = 0;
+      unsigned long v = strtoul(buf, NULL, 10);
+      if (v > 1000000)
+         v /= 1000;
+      return (unsigned)v;
+   }
+
+   return 0;
+}
+
 /* Wait function installed on every output vk_sync.  It blocks on the
  * kbase atom numbers stored in targets[]; all earlier atoms of the submit
  * are ordered before the final one, so a single target is sufficient. */
@@ -352,6 +384,7 @@ panvk_per_arch(gpu_queue_submit)(struct vk_queue *vk_queue, struct vk_queue_subm
       jm_diag_atoms_max = atom_count;
 
    if (jm_diag_submits == 1) {
+      jm_diag_window_start_ns = t0;
       mesa_logi("PanVK JM: async atom submission active (%u atoms)", atom_count);
       panvk_jm_log("active: first submit %u atoms, %" PRIu64 " us\n",
                    atom_count, dt / 1000);
@@ -378,6 +411,82 @@ panvk_per_arch(gpu_queue_submit)(struct vk_queue *vk_queue, struct vk_queue_subm
                       ? (unsigned)(jm_diag_wait_ns / 1000 / jm_diag_waits)
                       : 0,
                    (unsigned)(jm_diag_wait_max_ns / 1000));
+      const uint64_t now = os_time_get_nano();
+      const uint64_t wall_ns =
+         jm_diag_window_start_ns ? now - jm_diag_window_start_ns : 0;
+
+      uint64_t draw_ns = atomic_exchange_explicit(
+         &panvk_jm_diag.draw_ns, 0, memory_order_relaxed);
+      uint64_t draw_count = atomic_exchange_explicit(
+         &panvk_jm_diag.draw_count, 0, memory_order_relaxed);
+      uint64_t barrier_ns = atomic_exchange_explicit(
+         &panvk_jm_diag.barrier_ns, 0, memory_order_relaxed);
+      uint64_t barrier_count = atomic_exchange_explicit(
+         &panvk_jm_diag.barrier_count, 0, memory_order_relaxed);
+      uint64_t render_ns = atomic_exchange_explicit(
+         &panvk_jm_diag.render_ns, 0, memory_order_relaxed);
+      uint64_t render_count = atomic_exchange_explicit(
+         &panvk_jm_diag.render_count, 0, memory_order_relaxed);
+      uint64_t desc_ns = atomic_exchange_explicit(
+         &panvk_jm_diag.desc_ns, 0, memory_order_relaxed);
+      uint64_t desc_count = atomic_exchange_explicit(
+         &panvk_jm_diag.desc_count, 0, memory_order_relaxed);
+      uint64_t update_ns = atomic_exchange_explicit(
+         &panvk_jm_diag.update_ns, 0, memory_order_relaxed);
+      uint64_t update_count = atomic_exchange_explicit(
+         &panvk_jm_diag.update_count, 0, memory_order_relaxed);
+      uint64_t vbs_ns = atomic_exchange_explicit(
+         &panvk_jm_diag.vbs_ns, 0, memory_order_relaxed);
+      uint64_t vbs_count = atomic_exchange_explicit(
+         &panvk_jm_diag.vbs_count, 0, memory_order_relaxed);
+      uint64_t ib_ns = atomic_exchange_explicit(
+         &panvk_jm_diag.ib_ns, 0, memory_order_relaxed);
+      uint64_t ib_count = atomic_exchange_explicit(
+         &panvk_jm_diag.ib_count, 0, memory_order_relaxed);
+      uint64_t push_ns = atomic_exchange_explicit(
+         &panvk_jm_diag.push_ns, 0, memory_order_relaxed);
+      uint64_t push_count = atomic_exchange_explicit(
+         &panvk_jm_diag.push_count, 0, memory_order_relaxed);
+      uint64_t present_ns = atomic_exchange_explicit(
+         &panvk_jm_diag.present_ns, 0, memory_order_relaxed);
+      uint64_t present_count = atomic_exchange_explicit(
+         &panvk_jm_diag.present_count, 0, memory_order_relaxed);
+      const unsigned gpu_khz = jm_read_gpu_khz();
+
+      panvk_jm_log("cpu wall_ms=%" PRIu64 " interval_us=%" PRIu64
+                   " draw_us=%" PRIu64 " draw_n=%" PRIu64
+                   " barrier_us=%" PRIu64 " barrier_n=%" PRIu64
+                   " render_us=%" PRIu64 " render_n=%" PRIu64
+                   " desc_us=%" PRIu64 " desc_n=%" PRIu64
+                   " update_us=%" PRIu64 " update_n=%" PRIu64
+                   " vbs_us=%" PRIu64 " vbs_n=%" PRIu64
+                   " ib_us=%" PRIu64 " ib_n=%" PRIu64
+                   " push_us=%" PRIu64 " push_n=%" PRIu64
+                   " present_us=%" PRIu64 " present_n=%" PRIu64
+                   " gpu_khz=%u\n",
+                   wall_ns / 1000000,
+                   wall_ns / 1000 / jm_diag_submits,
+                   draw_ns / 1000 / jm_diag_submits,
+                   draw_count / jm_diag_submits,
+                   barrier_ns / 1000 / jm_diag_submits,
+                   barrier_count / jm_diag_submits,
+                   render_ns / 1000 / jm_diag_submits,
+                   render_count / jm_diag_submits,
+                   desc_ns / 1000 / jm_diag_submits,
+                   desc_count / jm_diag_submits,
+                   update_ns / 1000 / jm_diag_submits,
+                   update_count / jm_diag_submits,
+                   vbs_ns / 1000 / jm_diag_submits,
+                   vbs_count / jm_diag_submits,
+                   ib_ns / 1000 / jm_diag_submits,
+                   ib_count / jm_diag_submits,
+                   push_ns / 1000 / jm_diag_submits,
+                   push_count / jm_diag_submits,
+                   present_ns / 1000 / jm_diag_submits,
+                   present_count / jm_diag_submits,
+                   gpu_khz);
+      jm_diag_window_start_ns = now;
+
       jm_diag_submit_ns = jm_diag_wait_ns = 0;
       jm_diag_submit_max_ns = jm_diag_wait_max_ns = 0;
       jm_diag_submits = jm_diag_waits = jm_diag_atoms = jm_diag_atoms_max = 0;
