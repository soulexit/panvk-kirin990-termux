    }
    cmdbuf->state.gfx.ib.index_size = vk_index_type_to_bytes(indexType);
+
+   panvk_jm_diag_end(&panvk_jm_diag.ib_ns, &panvk_jm_diag.ib_count,
+                     _diag_t0);
 }
