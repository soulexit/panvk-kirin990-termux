From c26e5754225b0af0e4c175a09d95d95bd6fcd9bc Mon Sep 17 00:00:00 2001
From: panvk-luke <panvk-luke@localhost>
Date: Wed, 21 Oct 2026 15:09:38 +0300
Subject: [PATCH panvk-kirin990 18/23] panvk/jm: batch tiler+fragment atoms
 into one ioctl

Submit the tiler and fragment atoms of a PanVK batch in a single
JOB_SUBMIT ioctl.  The kernel walks the user atom array with the 56-byte
uAPI stride, so pack each atom into a stride-sized slot instead of
passing the 64-byte C struct array directly; the misaligned second atom
made the tiler atom fail with event 0x4003.

Also append submit/wait statistics to
/sdcard/Android/data/com.armsx2.nightly/files/logs/panvk_jm.log (or the
path in PANVK_JM_LOG), since ARMSX2 does not capture driver stderr.  The
summary records atoms per submit, submit microseconds and output-wait
microseconds, which separates driver CPU cost from GPU/present cost.
---
 src/panfrost/lib/kmod/kbase_kmod.c          |  95 +++++++++++
 src/panfrost/lib/kmod/kbase_kmod.h          |   9 ++
 src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c | 166 +++++++++++++-------
 3 files changed, 217 insertions(+), 53 deletions(-)

diff --git a/src/panfrost/lib/kmod/kbase_kmod.c b/src/panfrost/lib/kmod/kbase_kmod.c
index 49778b2ca27..d377e6a6af3 100644
--- a/src/panfrost/lib/kmod/kbase_kmod.c
+++ b/src/panfrost/lib/kmod/kbase_kmod.c
@@ -2314,6 +2314,101 @@ kbase_kmod_job_submit_dep(struct pan_kmod_dev *dev, uint64_t jc,
    return atom.atom_number;
 }
 
+uint64_t
+kbase_kmod_submit_batch(struct pan_kmod_dev *dev, uint64_t vtc_jc,
+                        uint64_t frag_jc, uint64_t prev_atom)
+{
+   struct kbase_kmod_dev *kd = container_of(dev, struct kbase_kmod_dev, base);
+   if (kd->is_csf) {
+      errno = ENOTSUP;
+      return 0;
+   }
+
+   const bool has_vtc = vtc_jc != 0;
+   const bool has_frag = frag_jc != 0;
+   if (!has_vtc && !has_frag)
+      return prev_atom;
+
+   struct kbase_atom_slot *slots[2] = { NULL, NULL };
+   unsigned nr = 0;
+
+   if (has_vtc) {
+      slots[nr] = kbase_atom_alloc(kd, BASE_JD_REQ_T | BASE_JD_REQ_CS |
+                                   BASE_JD_REQ_V, has_frag);
+      if (!slots[nr])
+         return 0;
+      nr++;
+   }
+   if (has_frag) {
+      slots[nr] = kbase_atom_alloc(kd, BASE_JD_REQ_FS, false);
+      if (!slots[nr]) {
+         if (slots[0]) {
+            simple_mtx_lock(&kd->atoms_lock);
+            slots[0]->atom_number = 0;
+            simple_mtx_unlock(&kd->atoms_lock);
+         }
+         return 0;
+      }
+      nr++;
+   }
+
+   struct base_jd_atom atoms[2] = { 0 };
+   uint64_t vtc_num = 0, frag_num = 0;
+   unsigned idx = 0;
+
+   if (has_vtc) {
+      vtc_num = slots[idx]->atom_number;
+      atoms[idx].jc = vtc_jc;
+      atoms[idx].core_req = BASE_JD_REQ_T | BASE_JD_REQ_CS | BASE_JD_REQ_V;
+      atoms[idx].atom_number = (uint8_t)vtc_num;
+      if (prev_atom) {
+         atoms[idx].pre_dep[0].atom_id = (uint8_t)prev_atom;
+         atoms[idx].pre_dep[0].dependency_type = BASE_JD_DEP_TYPE_DATA;
+      }
+      idx++;
+   }
+
+   if (has_frag) {
+      frag_num = slots[idx]->atom_number;
+      atoms[idx].jc = frag_jc;
+      atoms[idx].core_req = BASE_JD_REQ_FS;
+      atoms[idx].atom_number = (uint8_t)frag_num;
+      const uint64_t dep = has_vtc ? vtc_num : prev_atom;
+      if (dep) {
+         atoms[idx].pre_dep[0].atom_id = (uint8_t)dep;
+         atoms[idx].pre_dep[0].dependency_type = BASE_JD_DEP_TYPE_DATA;
+      }
+      idx++;
+   }
+
+   /* The kernel walks the user atom array with the uAPI stride (56 bytes
+    * on this generation), while the literal C struct is 64 bytes.  Pack
+    * each atom into a stride-sized slot instead of passing the struct
+    * array directly, otherwise the second atom is read from the middle
+    * of the first one. */
+   uint8_t atom_buf[2 * KBASE_JM_ATOM_STRIDE];
+   for (unsigned i = 0; i < nr; i++) {
+      memcpy(&atom_buf[i * KBASE_JM_ATOM_STRIDE], &atoms[i],
+             KBASE_JM_ATOM_STRIDE);
+   }
+
+   struct kbase_ioctl_job_submit sub = {
+      .addr = (uintptr_t)atom_buf,
+      .nr_atoms = nr,
+      .stride = KBASE_JM_ATOM_STRIDE,
+   };
+   if (ioctl(dev->fd, KBASE_IOCTL_JOB_SUBMIT, &sub) < 0) {
+      mesa_loge("kbase: JOB_SUBMIT(batch) failed: %s", strerror(errno));
+      simple_mtx_lock(&kd->atoms_lock);
+      for (unsigned i = 0; i < nr; i++)
+         slots[i]->atom_number = 0;
+      simple_mtx_unlock(&kd->atoms_lock);
+      return 0;
+   }
+
+   return has_frag ? frag_num : vtc_num;
+}
+
 void
 kbase_kmod_atom_release(struct pan_kmod_dev *dev, uint64_t atom_num)
 {
diff --git a/src/panfrost/lib/kmod/kbase_kmod.h b/src/panfrost/lib/kmod/kbase_kmod.h
index 01ae090e572..c8a4a1d4cd0 100644
--- a/src/panfrost/lib/kmod/kbase_kmod.h
+++ b/src/panfrost/lib/kmod/kbase_kmod.h
@@ -119,6 +119,15 @@ uint64_t kbase_kmod_job_submit_dep(struct pan_kmod_dev *dev, uint64_t jc,
                                    uint8_t dep0_type, uint64_t dep1,
                                    uint8_t dep1_type, bool no_waiter);
 
+/* Submit the tiler and fragment atoms of one PanVK batch in a single
+ * JOB_SUBMIT ioctl.  vtc_jc/frag_jc may be zero when absent.  The
+ * fragment atom depends on the tiler atom with DATA, and the tiler atom
+ * depends on prev_atom (the previous queue tail) with DATA.  Returns the
+ * last submitted atom number, prev_atom when there is nothing to submit,
+ * or 0 on failure. */
+uint64_t kbase_kmod_submit_batch(struct pan_kmod_dev *dev, uint64_t vtc_jc,
+                                 uint64_t frag_jc, uint64_t prev_atom);
+
 /* Wait for a JM atom.  timeout_ns < 0 waits forever.  Returns true when
  * the atom completed successfully. */
 bool kbase_kmod_wait_atom(struct pan_kmod_dev *dev, uint64_t atom_number,
diff --git a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
index a6867922f3a..3197c0fc5d9 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
@@ -34,12 +34,70 @@
 
 #include "drm-uapi/panfrost_drm.h"
 #include "drm-uapi/mali_kbase_ioctl.h"
+#include <fcntl.h>
 #include <inttypes.h>
 #include <poll.h>
-
-/* Lightweight diagnostics: one line every 120 submissions/waits. */
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+/* Lightweight diagnostics: one summary line every 120 submissions/waits.
+ * The summary is also appended to a file inside ARMSX2's own scoped
+ * storage, because the app's emulog does not capture driver stderr. */
 static uint64_t jm_diag_submit_ns, jm_diag_wait_ns;
+static uint64_t jm_diag_submit_max_ns, jm_diag_wait_max_ns;
 static unsigned jm_diag_submits, jm_diag_waits, jm_diag_atoms;
+static unsigned jm_diag_atoms_max;
+
+static int jm_log_fd = -2;
+static pthread_mutex_t jm_log_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static void
+panvk_jm_log_init(void)
+{
+   if (jm_log_fd != -2)
+      return;
+
+   const char *path = getenv("PANVK_JM_LOG");
+   if (!path || !path[0])
+      path = "/sdcard/Android/data/com.armsx2.nightly/files/logs/panvk_jm.log";
+
+   jm_log_fd = open(path, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0666);
+   if (jm_log_fd < 0)
+      return;
+
+   char hdr[320];
+   int n = snprintf(hdr, sizeof(hdr), "PanVK JM log: %s (pid %d)\n",
+                    path, (int)getpid());
+   if (n > 0)
+      (void)write(jm_log_fd, hdr, n);
+}
+
+static void
+panvk_jm_log(const char *fmt, ...)
+{
+   if (jm_log_fd == -2)
+      panvk_jm_log_init();
+   if (jm_log_fd < 0)
+      return;
+
+   char buf[512];
+   va_list ap;
+   va_start(ap, fmt);
+   int n = vsnprintf(buf, sizeof(buf), fmt, ap);
+   va_end(ap);
+   if (n <= 0)
+      return;
+   if (n > (int)sizeof(buf))
+      n = sizeof(buf);
+
+   pthread_mutex_lock(&jm_log_lock);
+   ssize_t res = write(jm_log_fd, buf, n);
+   (void)res;
+   pthread_mutex_unlock(&jm_log_lock);
+}
 
 /* Wait function installed on every output vk_sync.  It blocks on the
  * kbase atom numbers stored in targets[]; all earlier atoms of the submit
@@ -73,7 +131,10 @@ panvk_jm_kbase_wait_atoms(
       }
    }
 
-   jm_diag_wait_ns += os_time_get_nano() - wait_t0;
+   const uint64_t wait_dt = os_time_get_nano() - wait_t0;
+   jm_diag_wait_ns += wait_dt;
+   if (wait_dt > jm_diag_wait_max_ns)
+      jm_diag_wait_max_ns = wait_dt;
    jm_diag_waits++;
    return result;
 }
