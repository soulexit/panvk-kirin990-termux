diff --git a/src/vulkan/runtime/vk_android.c b/src/vulkan/runtime/vk_android.c
index f72118ecc82..ea72f1bedc6 100644
--- a/src/vulkan/runtime/vk_android.c
+++ b/src/vulkan/runtime/vk_android.c
@@ -54,6 +54,20 @@
 
 static struct u_gralloc *_gralloc;
 
+/* Some gralloc implementations put a metadata/ashmem fd in data[0] and the
+ * real dma-buf in a later slot.  lseek(SEEK_END) only succeeds on dma-bufs,
+ * so use it to locate the right descriptor instead of hard-coding an index.
+ */
+static int
+vk_android_find_dma_buf_fd(const native_handle_t *handle)
+{
+   for (int i = 0; i < handle->numFds; i++) {
+      if (lseek(handle->data[i], 0, SEEK_END) >= 0)
+         return handle->data[i];
+   }
+   return handle->data[0];
+}
+
 static void
 vk_android_init_ugralloc_once(void)
 {
@@ -197,7 +211,7 @@ vk_android_import_anb_memory(struct vk_device *device,
 {
    assert(anb && anb->handle && anb->handle->numFds > 0);
 
-   int dma_buf_fd = anb->handle->data[0];
+   int dma_buf_fd = vk_android_find_dma_buf_fd(anb->handle);
 
    /* Query image memory requirements for size and supported memory types */
    VkMemoryRequirements mem_reqs;
