 8 files changed, 131 insertions(+), 44 deletions(-)

diff --git a/include/drm-uapi/mali_kbase_ioctl.h b/include/drm-uapi/mali_kbase_ioctl.h
index c0b110a8241..d863189b322 100644
--- a/include/drm-uapi/mali_kbase_ioctl.h
+++ b/include/drm-uapi/mali_kbase_ioctl.h
@@ -344,6 +344,28 @@ union kbase_ioctl_mem_import {
 #define KBASE_IOCTL_MEM_IMPORT \
    _IOWR(KBASE_IOCTL_TYPE, 22, union kbase_ioctl_mem_import)
 
+/* Older JM kernels (uAPI < 11.20) use a 32-byte mem_import structure.  The
+ * field offsets are identical to the modern one; only the trailing padding
+ * differs, so the ioctl number (which encodes sizeof) changes.
+ */
+union kbase_ioctl_mem_import_11_16 {
+   struct {
+      __u64 flags;
+      __u64 phandle;
+      __u32 type;
+      __u32 padding;
+      __u64 padding2;
+   } in;
+   struct {
+      __u64 flags;
+      __u64 gpu_va;
+      __u64 va_pages;
+      __u64 padding;
+   } out;
+};
+#define KBASE_IOCTL_MEM_IMPORT_11_16 \
+   _IOWR(KBASE_IOCTL_TYPE, 22, union kbase_ioctl_mem_import_11_16)
+
 /* base_mem_import_type */
 #define BASE_MEM_IMPORT_TYPE_INVALID     0
 #define BASE_MEM_IMPORT_TYPE_UMM         2 /* dma-buf */
diff --git a/src/panfrost/lib/kmod/kbase_kmod.c b/src/panfrost/lib/kmod/kbase_kmod.c
index f53688425dc..574676dcfd8 100644
--- a/src/panfrost/lib/kmod/kbase_kmod.c
+++ b/src/panfrost/lib/kmod/kbase_kmod.c
@@ -72,6 +72,12 @@ struct kbase_kmod_dev {
    /* True for the CSF flavour of kbase (arch >= 10), false for JM. */
    bool is_csf;
 
+   /* JM uAPI version reported by the handshake.  Some ioctl layouts changed
+    * between minor versions (JIT init before 11.20, mem_import before 11.20),
+    * so keep it around to pick the right structure size. */
+   uint16_t uapi_major;
+   uint16_t uapi_minor;
+
    /* CSF interface information (CSF only), queried from
     * KBASE_IOCTL_CS_GET_GLB_IFACE and stored in the panthor uAPI layout
     * so CSF-generic code can consume either backend. */
@@ -1237,6 +1243,9 @@ kbase_kmod_dev_create(int fd, uint32_t flags,
       goto err_unmap_tracking;
    }
 
+   kbase_dev->uapi_major = ver.major;
+   kbase_dev->uapi_minor = ver.minor;
+
    /* Report the kernel uAPI version from the handshake (the caller can't
     * use drmGetVersion() on a kbase fd, so drv_info is either NULL or a
     * zeroed fallback). */
@@ -1479,7 +1488,28 @@ kbase_kmod_import_dmabuf(struct pan_kmod_dev *dev,
       },
    };
 
-   if (ioctl(dev->fd, KBASE_IOCTL_MEM_IMPORT, &req)) {
+   int import_ret;
+   if (kbase_dev->uapi_major == 11 && kbase_dev->uapi_minor < 20) {
+      /* Older JM kernels encode sizeof() in the ioctl number and use the
+       * 32-byte layout; the modern 24-byte command is rejected with ENOTTY. */
+      union kbase_ioctl_mem_import_11_16 req_11_16 = {
+         .in = {
+            .flags = import_flags,
+            .phandle = (uintptr_t)&import_fd,
+            .type = BASE_MEM_IMPORT_TYPE_UMM,
+         },
+      };
+      import_ret = ioctl(dev->fd, KBASE_IOCTL_MEM_IMPORT_11_16, &req_11_16);
+      if (import_ret == 0) {
+         req.out.flags = req_11_16.out.flags;
+         req.out.gpu_va = req_11_16.out.gpu_va;
+         req.out.va_pages = req_11_16.out.va_pages;
+      }
+   } else {
+      import_ret = ioctl(dev->fd, KBASE_IOCTL_MEM_IMPORT, &req);
+   }
+
+   if (import_ret) {
       mesa_loge("kbase: KBASE_IOCTL_MEM_IMPORT failed: %s", strerror(errno));
       goto err_close_dmabuf;
    }
diff --git a/src/panfrost/vulkan/panvk_android.c b/src/panfrost/vulkan/panvk_android.c
index 82f9638c8ea..3044c68fb67 100644
--- a/src/panfrost/vulkan/panvk_android.c
+++ b/src/panfrost/vulkan/panvk_android.c
@@ -11,6 +11,21 @@
 #include "vndk/hardware_buffer.h"
 #include "vulkan/vk_android_native_buffer.h"
 
+#include <unistd.h>
+
+/* See the matching helper in vk_android.c: vendor gralloc handles may keep
+ * the dma-buf at an index other than data[0].
+ */
+static int
+panvk_android_find_dma_buf_fd(const native_handle_t *handle)
+{
+   for (int i = 0; i < handle->numFds; i++) {
+      if (lseek(handle->data[i], 0, SEEK_END) >= 0)
+         return handle->data[i];
+   }
+   return handle->data[0];
+}
+
 #include "vk_alloc.h"
 #include "vk_android.h"
 #include "vk_device_memory.h"
@@ -257,7 +272,7 @@ panvk_android_import_ahb_memory(VkDevice device,
    VK_FROM_HANDLE(vk_device, dev, device);
    const native_handle_t *handle = AHardwareBuffer_getNativeHandle(ahb);
    assert(handle && handle->numFds > 0);
-   int dma_buf_fd = handle->data[0];
+   int dma_buf_fd = panvk_android_find_dma_buf_fd(handle);
    VkResult result;
 
    VkImage img_handle = VK_NULL_HANDLE;
