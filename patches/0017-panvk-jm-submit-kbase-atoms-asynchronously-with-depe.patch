+/* JM job atoms (kbase uAPI 11.x).  The kernel-side atom is 56 bytes on
+ * this generation (renderpass_id + padding), while the literal C struct
+ * is 64 bytes; only the first 56 bytes are read by the kernel. */
+#define BASE_JD_DEP_TYPE_DATA 1
+#define BASE_JD_DEP_TYPE_ORDER 2
+
+#define BASE_JD_REQ_FS (1u << 0)
+#define BASE_JD_REQ_CS (1u << 1)
+#define BASE_JD_REQ_T (1u << 2)
+#define BASE_JD_REQ_CF (1u << 3)
+#define BASE_JD_REQ_V (1u << 4)
+
+/* Submit one JM atom, optionally depending on up to two earlier atoms.
+ * Returns the user atom number (1..255) or 0 on failure.  When no_waiter
+ * is true the atom slot is dropped as soon as the kernel reports
+ * completion; otherwise a waiter must consume it with
+ * kbase_kmod_wait_atom() (an atom may still be waited on after its slot
+ * has been reclaimed). */
+uint64_t kbase_kmod_job_submit_dep(struct pan_kmod_dev *dev, uint64_t jc,
+                                   uint32_t core_req, uint64_t dep0,
+                                   uint8_t dep0_type, uint64_t dep1,
+                                   uint8_t dep1_type, bool no_waiter);
+
+/* Wait for a JM atom.  timeout_ns < 0 waits forever.  Returns true when
+ * the atom completed successfully. */
+bool kbase_kmod_wait_atom(struct pan_kmod_dev *dev, uint64_t atom_number,
+                          int64_t timeout_ns);
+
+/* Drop a waiter reference on an atom that will never be waited on. */
+void kbase_kmod_atom_release(struct pan_kmod_dev *dev, uint64_t atom_num);
+
 #if defined(__cplusplus)
 } // extern "C"
 #endif
