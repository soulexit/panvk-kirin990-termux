diff --git a/src/panfrost/lib/kmod/kbase_kmod.c b/src/panfrost/lib/kmod/kbase_kmod.c
index 574676dcfd8..49778b2ca27 100644
--- a/src/panfrost/lib/kmod/kbase_kmod.c
+++ b/src/panfrost/lib/kmod/kbase_kmod.c
@@ -66,6 +66,65 @@ const struct pan_kmod_ops kbase_kmod_ops;
  * Internal device / BO / VM objects
  * ---------------------------------------------------------------------- */
 
+/* JM submission atom table (ported from the async kbase JM backend).
+ *
+ * kbase has no DRM syncobjs, so a submitted job can only be observed
+ * through the per-context event stream.  Each atom gets a user atom
+ * number (1..255) and the event reader records completion in this table.
+ * A vk_sync can then be armed to wait for an atom number without blocking
+ * the submission path. */
+
+struct base_jd_udata {
+   __u64 blob[2];
+};
+
+struct base_jd_atom {
+   __u64 jc;
+   struct base_jd_udata udata;
+   __u64 extres_list;
+   __u16 nr_extres;
+   __u8 jit_id[2];
+   struct {
+      __u8 atom_id;
+      __u8 dependency_type;
+   } pre_dep[2];
+   __u8 atom_number;
+   __u8 prio;
+   __u8 device_nr;
+   __u8 jobslot;
+   __u32 core_req;
+   __u8 renderpass_id;
+   __u8 padding[15];
+};
+
+_Static_assert(sizeof(struct base_jd_atom) == 64, "JM atom size");
+_Static_assert(offsetof(struct base_jd_atom, atom_number) == 40,
+               "JM atom_number offset");
+_Static_assert(offsetof(struct base_jd_atom, core_req) == 44,
+               "JM core_req offset");
+_Static_assert(offsetof(struct base_jd_atom, renderpass_id) == 48,
+               "JM renderpass_id offset");
+
+#define BASE_JD_EVENT_DONE 0x01
+
+struct base_jd_event_v2 {
+   __u32 event_code;
+   __u8 atom_number;
+   __u8 padding[3];
+   struct base_jd_udata udata;
+};
+
+#define KBASE_JM_ATOM_STRIDE 56
+#define KBASE_MAX_ATOMS 256
+
+struct kbase_atom_slot {
+   uint64_t atom_number;
+   uint32_t core_req;
+   bool completed;
+   bool errored;
+   uint32_t waiters;
+};
+
 struct kbase_kmod_dev {
    struct pan_kmod_dev base;
 
